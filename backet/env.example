# Postgres
POSTGRES_USER=families
POSTGRES_PASSWORD=families
POSTGRES_DB=families
DATABASE_URL=postgresql+asyncpg://families:families@postgres:5432/families

# MinIO only
MINIO_ENDPOINT=http://localhost:9000
# Public endpoint for presigned URLs (client-facing). If empty, MINIO_ENDPOINT is used.
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_FAMILIES=families-bucket
MINIO_REGION=us-east-1
MINIO_USE_SSL=false

# Security
JWT_SECRET=dev-secret-change
JWT_ALGORITHM=HS256

# Presigned URL TTLs (seconds)
PRESIGNED_PUT_EXPIRES=900
PRESIGNED_GET_EXPIRES=300

# Logging
LOG_LEVEL=INFO