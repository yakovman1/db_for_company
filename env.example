# Postgres
POSTGRES_USER=families
POSTGRES_PASSWORD=families
POSTGRES_DB=families
DATABASE_URL=postgresql+asyncpg://families:families@postgres:5432/families

# RustFS server
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_VOLUMES=/data
RUSTFS_ADDRESS=0.0.0.0:9000
RUSTFS_CONSOLE_ADDRESS=0.0.0.0:9001
RUSTFS_CONSOLE_ENABLE=true
RUSTFS_CORS_ALLOWED_ORIGINS=*
RUSTFS_CONSOLE_CORS_ALLOWED_ORIGINS=*

# S3-compatible storage used by backend
MINIO_ENDPOINT=http://rustfs:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=rustfsadmin
MINIO_SECRET_KEY=rustfsadmin
MINIO_BUCKET_FAMILIES=families-bucket
MINIO_BUCKET_PREVIEW=preview-bucket
MINIO_REGION=us-east-1
MINIO_USE_SSL=false

# Legacy MinIO credentials, used only by the migration profile.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MIGRATION_MINIO_ENDPOINT=http://minio:9000

# Security
JWT_SECRET=dev-secret-change
JWT_ALGORITHM=HS256
JWT_EXPIRES_SECONDS=28800

# Presigned URL TTLs (seconds)
PRESIGNED_PUT_EXPIRES=900
PRESIGNED_GET_EXPIRES=300

# Logging
LOG_LEVEL=INFO

# --- AIRFLOW ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_API_AUTH_JWT_SECRET=change-this-to-a-stable-random-secret

# --- SUPERSET ---
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@example.com
SUPERSET_SECRET_KEY=
SUPERSET_APP_NAME=ATP architekten ingenieure
SUPERSET_APP_ICON=
SUPERSET_LOGO_S3_BUCKET=for-superset
SUPERSET_LOGO_S3_KEY=ATP_tlp_4c.png
SUPERSET_FAVICON_S3_KEY=ATP_TLP.jpg
SUPERSET_LOGO_HEIGHT=64px
SUPERSET_LOGO_MAX_WIDTH=360
SUPERSET_LOGO_TARGET_PATH=/superset/welcome/
# ATP Corporate Design (see atp-corporate-design skill)
SUPERSET_BRAND_COLOR=#CC0033
SUPERSET_BRAND_COLOR_LINK=#CC0033
SUPERSET_BRAND_COLOR_TEXT=#000000
SUPERSET_BRAND_COLOR_NEUTRAL=#666666
SUPERSET_BRAND_COLOR_BG=#E6E6E6
SUPERSET_BRAND_COLOR_SURFACE=#FFFFFF
SUPERSET_BRAND_COLOR_SUCCESS=#666666
SUPERSET_BRAND_COLOR_WARNING=#666666
SUPERSET_BRAND_COLOR_ERROR=#CC0033
SUPERSET_BRAND_COLOR_INFO=#666666
SUPERSET_BRAND_FONT_UI="Univers, Linotype Univers, Helvetica Neue, Helvetica, Arial, sans-serif"
SUPERSET_BRAND_FONT_CODE="Univers, Linotype Univers, Courier New, monospace"
SUPERSET_ROW_LIMIT=50000
SUPERSET_SQL_MAX_ROW=100000
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CACHE_DB=1